{
  "name": "git-remote-yida",
  "version": "0.1.0",
  "description": "Git remote helper that uses Yida (宜搭) as a storage backend",
  "main": "dist/index.js",
  "bin": {
    "git-remote-yida": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx test/final.ts",
    "pkg": "pkg dist/index.js --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output bin/git-remote-yida"
  },
  "keywords": [
    "git",
    "remote",
    "helper",
    "yida",
    "dingtalk"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}